# OpenAIRealtimeToolkit example — optional. The app runs without this on a shared
# test key; set your own before shipping anything. To use it:
#   cp .env.example .env
# then fill in the key below and uncomment the `@env` import + `openAIApiKey`
# prop in App.tsx.
#
# Your OpenAI API key (the real value lives in .env, which is gitignored).
OPENAI_API_KEY=YOUR_OPENAI_API_KEY
